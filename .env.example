# URL racine de l'API Symfony. Copier ce fichier en `.env.local` pour surcharger.
# `VITE_API_URL` est la variable lue par l'application. `VITE_API_BASE_URL` reste
# acceptée pour compatibilite avec les environnements de CI/CD existants.
VITE_API_URL=http://127.0.0.1:8000/api

# Delai maximal d'une requete API, en millisecondes.
VITE_API_TIMEOUT_MS=10000
